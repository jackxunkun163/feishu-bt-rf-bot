# systemd 服务示例：sudo cp btbot.service /etc/systemd/system/ && sudo systemctl enable --now btbot
[Unit]
Description=MTK BT RF Feishu bot
After=network-online.target
Wants=network-online.target

[Service]
User=build
WorkingDirectory=/home/build/btbot
ExecStart=/usr/bin/python3 -m btbot.main -c config.yaml
Restart=always
RestartSec=10
# 收到 SIGTERM 后机器人会终止编译并还原源码，留足时间
KillMode=mixed
TimeoutStopSec=180
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
